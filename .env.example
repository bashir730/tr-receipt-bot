// ---------------------------------------------------------------
// tr-receipt-bot — .env.example (no real credentials)
// Copy to .env and adjust. None of these values are secret.
// ---------------------------------------------------------------

# SQLite database file path (created automatically, persists across restarts)
DB_PATH=./data/receipts.db

# Baileys session directory (created automatically)
SESSION_DIR=./session

# OCR language for Tesseract (Turkish + English fallback)
OCR_LANG=tur+eng

# Log level: debug | info | warn | error
LOG_LEVEL=info

# Optional: only these group JIDs are processed (comma separated,
# e.g. 1234-5678@g.us,9876-5432@g.us). Leave empty to process all groups.
ALLOWED_GROUPS=

# Optional: log every processed image even when it is ignored (true/false)
VERBOSE_IGNORED=false
